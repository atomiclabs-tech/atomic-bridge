<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet rectangle, 8dp radius. Pressed shifts fill one step; text stays put. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ws_line_strong">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape><solid android:color="@color/ws_line" /><corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="@color/ws_line_strong" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/ws_surface2" /><corners android:radius="8dp" />
                    <stroke android:width="1dp" android:color="@color/ws_line_strong" /></shape>
            </item>
        </selector>
    </item>
</ripple>
