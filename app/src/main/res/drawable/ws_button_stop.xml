<?xml version="1.0" encoding="utf-8"?>
<!-- Stop button: the one red control. Pressed darkens one step; text stays put. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ws_stop_pressed">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape><solid android:color="@color/ws_stop_pressed" /><corners android:radius="8dp" /></shape>
            </item>
            <item>
                <shape><solid android:color="@color/ws_stop_fill" /><corners android:radius="8dp" /></shape>
            </item>
        </selector>
    </item>
</ripple>
