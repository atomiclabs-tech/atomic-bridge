<?xml version="1.0" encoding="utf-8"?>
<!-- Atomic Labs Design Guide v3, Workshop room: status surface. One red = the mark in the header. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/ws_bg" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp"
        android:paddingTop="16dp" android:paddingBottom="32dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:layout_marginStart="-14dp"
                android:src="@drawable/ic_atomic" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Label" android:text="@string/status_eyebrow" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Display" android:layout_marginTop="2dp"
                    android:text="@string/app_name" android:accessibilityHeading="true" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical"
            android:background="@drawable/ws_live_card" android:padding="27dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Label" android:text="@string/status_link_label" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                <View android:id="@+id/status_led" android:layout_width="10dp" android:layout_height="10dp"
                    android:background="@drawable/ws_led" android:backgroundTint="@color/ws_amber" />
                <TextView android:id="@+id/status_tone" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Display" android:layout_marginStart="12dp"
                    android:text="@string/tone_working" android:accessibilityLiveRegion="polite" />
            </LinearLayout>
            <TextView android:id="@+id/connection_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/status_endpoint" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Mono"
                android:layout_marginTop="6dp" android:saveEnabled="false" />
            <TextView android:id="@+id/status_error" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small" android:textColor="@color/ws_alert"
                android:layout_marginTop="6dp" android:accessibilityLiveRegion="polite" android:saveEnabled="false" />
            <TextView android:id="@+id/grant_warning" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small" android:textColor="@color/ws_amber" android:layout_marginTop="6dp" />
            <TextView android:id="@+id/encryption_warning" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small" android:textColor="@color/ws_amber" android:layout_marginTop="6dp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:background="@color/ws_line" />
            <TextView android:id="@+id/device_id" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Mono" android:textIsSelectable="true" />
            <TextView android:id="@+id/grant_expiry" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Mono" android:layout_marginTop="4dp" />
            <!-- One slot: red "Kill link" while the link is on; "Connect" (or "Retry") when it is off. -->
            <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                style="@style/Ws.Button" android:text="@string/status_connect" android:visibility="gone" />
            <Button android:id="@+id/kill_switch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                style="@style/Ws.Button.Stop" android:text="@string/status_kill" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="@drawable/ws_card" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Label" android:text="@string/status_relay_url" android:labelFor="@id/relay_url" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/relay_url" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    style="@style/Ws.Mono" android:textColor="@color/ws_fg1" android:background="@drawable/ws_input"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:textCursorDrawable="@null"
                    android:inputType="textUri" android:singleLine="true" android:saveEnabled="false" />
                <Button android:id="@+id/save_url" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button" android:layout_marginStart="8dp"
                    android:text="@string/status_save" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Label"
                android:layout_marginTop="16dp" android:text="@string/pairing_code_label" android:labelFor="@id/pairing_code_input" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                <EditText android:id="@+id/pairing_code_input" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    style="@style/Ws.Mono" android:textColor="@color/ws_fg1" android:background="@drawable/ws_input"
                    android:paddingStart="12dp" android:paddingEnd="12dp" android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="6" android:singleLine="true" android:saveEnabled="false" />
                <Button android:id="@+id/pair" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button"
                    android:layout_marginStart="8dp" android:text="@string/pairing_pair" />
            </LinearLayout>
            <TextView android:id="@+id/pairing_hint" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small"
                android:layout_marginTop="8dp" android:text="@string/pairing_hint" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="28dp" android:text="@string/status_setup_label" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Heading" android:layout_marginTop="4dp"
            android:text="@string/status_permissions" android:accessibilityHeading="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small" android:layout_marginTop="6dp" android:text="@string/status_notifications_optional_hint" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="@drawable/ws_card" android:padding="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Label" android:text="@string/status_restricted_settings" android:accessibilityHeading="true" />
            <TextView android:id="@+id/restricted_settings_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:layout_marginTop="8dp" />
            <TextView android:id="@+id/restricted_settings_guidance" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Small" android:layout_marginTop="6dp" />
            <Button android:id="@+id/restricted_settings_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginTop="12dp"
                android:text="@string/status_open_app_info" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="@drawable/ws_card" android:paddingStart="20dp" android:paddingEnd="16dp"
            android:paddingTop="4dp" android:paddingBottom="4dp"
            android:showDividers="middle" android:divider="@drawable/ws_divider">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_accessibility" />
                    <TextView android:id="@+id/accessibility_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/accessibility_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_open_settings" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_battery" />
                    <TextView android:id="@+id/battery_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/battery_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_open_settings" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_unused" />
                    <TextView android:id="@+id/unused_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/unused_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_open_settings" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_notifications" />
                    <TextView android:id="@+id/notifications_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/notifications_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_sms" />
                    <TextView android:id="@+id/sms_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/sms_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_phone" />
                    <TextView android:id="@+id/call_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/call_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_contacts" />
                    <TextView android:id="@+id/contacts_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/contacts_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_location" />
                    <TextView android:id="@+id/location_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/location_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/status_background_location" />
                    <TextView android:id="@+id/background_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/background_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_open_settings" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/notification_access_title" />
                    <TextView android:id="@+id/notification_access_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/notification_access_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_open_settings" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/files_access_title" />
                    <TextView android:id="@+id/all_files_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/all_files_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_open_settings" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/audio_microphone_permission" />
                    <TextView android:id="@+id/microphone_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/microphone_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingTop="12dp" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Body" android:text="@string/audio_phone_state_permission" />
                    <TextView android:id="@+id/phone_state_state" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:layout_marginTop="2dp" />
                </LinearLayout>
                <Button android:id="@+id/phone_state_action" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Ws.Button.Small" android:layout_marginStart="12dp"
                    android:text="@string/status_grant_permission" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/app_version" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Ws.Label" android:textColor="@color/ws_fg5"
            android:layout_marginTop="24dp" android:gravity="center" />
    </LinearLayout>
</ScrollView>
