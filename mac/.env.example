# Relay configuration. Process environment values override relay.env values.
# Comma-separated literal IP addresses; loopback required; wildcard refused.
# Add this Mac's tailnet or LAN address so the phone can connect.
# Use port 0 for isolated tests.
ATOMIC_RELAY_HOST=127.0.0.1
# Optional phone-facing URL: ws/wss/http/https, host and optional port only.
# No path, query, fragment or credentials; cleartext requires a private literal IP.
# Hostnames require wss/https; http/https normalize to ws/wss; empty means unset.
ATOMIC_RELAY_PHONE_URL=
ATOMIC_RELAY_PORT=8767
# Existing sessions JSON. An empty value enables in-memory health/tests only.
ATOMIC_RELAY_SESSIONS_FILE=~/.hermes/hermes-relay-sessions.json
# Required regular secret file, mode 0600, at least 32 characters. Rotate and restart.
# An empty value refuses all admin requests (isolated health/tests only, WARNING).
ATOMIC_RELAY_ADMIN_SECRET_FILE=~/services/atomic-bridge/admin.secret
# Comma-separated trusted proxy IP addresses; empty trusts only transport peers.
# Forwarded client/TLS headers are used only when the transport peer is listed.
ATOMIC_RELAY_TRUSTED_PROXIES=
# Comma-separated exact package names or prefix.* patterns; both empty keeps all.
# Deny wins over allow; a non-empty allow list requires a match.
ATOMIC_RELAY_NOTIFY_ALLOW=
ATOMIC_RELAY_NOTIFY_DENY=
# Rotating log: 10 MiB per file, five backups; stderr receives WARNING and above.
ATOMIC_RELAY_LOG_FILE=~/services/atomic-bridge/logs/relay.log
# DEBUG, INFO (default), WARNING, ERROR, or CRITICAL.
ATOMIC_RELAY_LOG_LEVEL=INFO
# Private upload directory (mode 0700), maximum transfer MiB, token lifetime.
ATOMIC_RELAY_MEDIA_DIR=~/services/atomic-bridge/media
ATOMIC_RELAY_MEDIA_MAX_MB=256
ATOMIC_RELAY_MEDIA_TTL_SECONDS=86400
# Colon-separated registration roots; uploads are stored separately in the media directory.
ATOMIC_RELAY_MEDIA_ALLOWED_ROOTS=~/.hermes/workspace
# Defaults to the package version; reported in health and authentication responses.
ATOMIC_RELAY_SERVER_VERSION=2.3.0

# Plugin configuration (standard-library runtime, no automatic tool-call retry).
# HTTP loopback only: 127.0.0.1, [::1] or localhost; no credentials, query or fragment.
# Environment proxy settings are ignored for every request and download.
ANDROID_BRIDGE_URL=http://127.0.0.1:8767
# Cached after first read; on 401/403 re-read once without retrying the call.
ATOMIC_BRIDGE_ADMIN_SECRET_FILE=~/services/atomic-bridge/admin.secret
ANDROID_BRIDGE_TIMEOUT=30
ATOMIC_BRIDGE_PULL_DIR=~/.hermes/workspace/phone-files/

# Operator scripts. Session values are private; never put them on a command line.
BW=bw
# Use the caller's session as is when set; leave unset to use the session command.
# BW_SESSION=
# Required when BW_SESSION is unset; shell-style quoting, executed without a shell.
# ATOMIC_BW_SESSION_CMD=
# Optional caller-supplied vault CLI data directory; no account/path default.
# BITWARDENCLI_APPDATA_DIR=
